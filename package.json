{
  "name": "cardrove",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "site",
    "video"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "setup:cloud": "node scripts/create-connect-token.mjs",
    "dev:cloud": "vite --mode cloud --host 127.0.0.1 --port 4318",
    "build:cloud": "vite build --mode cloud",
    "dev:site": "npm run dev --workspace site",
    "build:site": "npm run build --workspace site",
    "preview:site": "npm run preview --workspace site",
    "video:render": "npm run render --workspace video",
    "video:stills": "npm run stills --workspace video"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "@supabase/supabase-js": "2.118.0",
    "@zip.js/zip.js": "^2.23.0",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "fzstd": "^0.1.1",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "sql.js": "^1.15.0",
    "svelte": "^5.0.0",
    "ts-fsrs": "^5.4.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "cookie": "2.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "0.14.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
