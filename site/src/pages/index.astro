---
import Base from '../layouts/Base.astro';
import CardDemo from '../components/CardDemo.astro';
import FeatureFilm from '../components/FeatureFilm.astro';
import { brand, link } from '../config';
---

<Base>
  <main id="content">
    <section class="opening" aria-labelledby="opening-title">
      <div class="opening-spread">
        <div class="opening-copy">
          <h1 id="opening-title">Your decks.<br />A daily <em>practice.</em></h1>
          <p>
            Flashcards for the things you want to remember. Bring your Anki decks, review a little
            each day, and keep your collection on infrastructure you control.
          </p>
          <div class="opening-actions">
            <a class="button primary" href={link('docs/self-host/')}>Set up Cardrove</a>
            <a class="text-link" href="#practice">Try a card first</a>
          </div>
          <p class="opening-detail">Open source · Self-hosted · Spaced repetition</p>
        </div>
        <FeatureFilm />
      </div>
    </section>

    <section class="practice-section" id="practice" aria-labelledby="practice-title">
      <div class="practice-intro">
        <h2 id="practice-title">Before you look,<br /><em>try to remember.</em></h2>
        <p>
          Read the question. Recall what you can, then reveal the answer. In Cardrove, you rate how
          well you remembered; FSRS uses that rating to schedule your next review.
        </p>
        <a class="text-link" href={link('docs/studying/')}>How studying works</a>
      </div>
      <CardDemo />
    </section>

    <section class="ownership-section" aria-labelledby="ownership-title">
      <div><h2 id="ownership-title">A collection<br /><em>of your own.</em></h2></div>
      <div class="ownership-copy">
        <p class="large-copy">
          Run {brand} for yourself. Connect your devices to one collection and one learning history.
        </p>
        <p>
          Start with a local server, or host it online with Cloudflare Pages and Supabase. Each
          installation belongs to one owner.
        </p>
        <a class="text-link" href={link('docs/architecture/')}>How it fits together</a>
      </div>
      <dl class="ownership-ledger">
        <div>
          <dt>Anki decks, brought along</dt>
          <dd>Import supported .apkg files with images, audio, simple cloze, and nested decks.</dd>
        </div>
        <div>
          <dt>A browser on either screen</dt>
          <dd>Study on your phone or computer. Cloud study needs an internet connection.</dd>
        </div>
        <div>
          <dt>A backup you can download</dt>
          <dd>Export your cloud collection, progress, and media to keep an independent copy.</dd>
        </div>
      </dl>
    </section>

    <section class="handbook-section" aria-labelledby="handbook-title">
      <div>
        <h2 id="handbook-title">Make yourself<br /><em>at home.</em></h2>
        <p>The handbook covers your first installation and the everyday details.</p>
        <a class="text-link" href={link('docs/')}>Read the handbook</a>
      </div>
      <div class="chapter-list">
        <a href={link('docs/self-host/')}>
          <div><h3>Set up your installation</h3><p>Choose a local server or a cloud setup.</p></div>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
          >
        </a>
        <a href={link('docs/compatibility/')}>
          <div><h3>Check your decks</h3><p>Supported Anki features and current limits.</p></div>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
          >
        </a>
        <a href={link('docs/devices-backups/')}>
          <div>
            <h3>Connect devices & back up</h3><p>Bring another screen. Keep a copy of your work.</p>
          </div>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
          >
        </a>
      </div>
    </section>
    <aside class="honest-note">
      <span>Before you import</span>
      <p>
        Cardrove imports supported Anki decks. It does not sync with AnkiWeb or support every Anki
        feature. <a href={link('docs/compatibility/')}>Check compatibility.</a>
      </p>
    </aside>
  </main>
</Base>
