---
import { link } from '../config';
const video = link('media/cardrove-tour.mp4');
---

<figure class="feature-film" id="feature-tour" aria-label="Cardrove in practice">
  <div class="film-screen">
    <button class="film-toggle" type="button" aria-label="Play Cardrove preview">
      <video
        muted
        loop
        playsinline
        preload="metadata"
        width="1920"
        height="1080"
        poster={link('media/cardrove-tour-poster.webp')}
        aria-hidden="true"
        disablepictureinpicture
      >
        <source src={video} type="video/mp4" />
      </video>
    </button>
    <p class="film-error" role="status" hidden>
      The preview could not load. <a href={video}>Open the MP4 directly</a>.
    </p>
  </div>
  <figcaption><span>A look inside</span><span>Sample collection</span></figcaption>
</figure>
<script>
  const film = document.querySelector<HTMLVideoElement>('.feature-film video');
  const toggle = document.querySelector<HTMLButtonElement>('.film-toggle');
  const error = document.querySelector<HTMLElement>('.film-error');
  if (film && toggle) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let manuallyPaused = false;
    let visible = false;
    const label = () => {
      toggle.setAttribute(
        'aria-label',
        film.paused ? 'Play Cardrove preview' : 'Pause Cardrove preview',
      );
    };
    const play = () => {
      film.muted = true;
      void film.play().catch(label);
    };
    const sync = () => {
      if (!visible || document.hidden || motion.matches || manuallyPaused) film.pause();
      else play();
    };
    toggle.addEventListener('click', () => {
      if (film.paused) {
        manuallyPaused = false;
        play();
      } else {
        manuallyPaused = true;
        film.pause();
      }
    });
    film.addEventListener('play', label);
    film.addEventListener('pause', label);
    const showError = () => {
      if (error) error.hidden = false;
      toggle.disabled = true;
    };
    film.addEventListener('error', showError);
    film.querySelector('source')?.addEventListener('error', showError);
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.15 },
    ).observe(film);
  }
</script>
