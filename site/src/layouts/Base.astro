---
import { brand, repository, link, chapters } from '../config';
import '../styles/site.css';
const {
  title = 'Self-hosted Flashcards & Spaced Repetition',
  seoTitle = title,
  description = 'Import supported Anki decks and study with FSRS spaced repetition on your phone or computer. Open-source flashcards you self-host, with your own collection and progress.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url).href;
const home = new URL(link(), Astro.site || Astro.url).href;
const isHome = canonical === home;
const fullTitle = isHome ? `${brand} | ${seoTitle}` : `${seoTitle} | ${brand}`;
const previewImage = new URL(link('media/cardrove-tour-poster.webp'), Astro.site || Astro.url).href;
const previewAlt = 'Cardrove review on a phone and computer, using a sample collection';
const handbook = new URL(link('docs/'), Astro.site || Astro.url).href;
const chapter = chapters.find(
  (item) =>
    new URL(link(`docs/${item.slug ? item.slug + '/' : ''}`), Astro.site || Astro.url).href ===
    canonical,
);
const schema = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': home + '#application',
      name: brand,
      url: home,
      description,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Any operating system with a modern web browser',
      screenshot: previewImage,
      license: `${repository.replace(/\/$/, '')}/blob/main/LICENSE`,
      sameAs: [repository],
    }
  : chapter
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: brand, item: home },
          { '@type': 'ListItem', position: 2, name: 'Handbook', item: handbook },
          ...(canonical === handbook
            ? []
            : [{ '@type': 'ListItem', position: 3, name: chapter.title, item: canonical }]),
        ],
      }
    : undefined;
const verification = import.meta.env.SITE_GOOGLE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={link('sitemap-index.xml')} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content={previewAlt} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="810" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewAlt} />
    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href={link('icons/cardrove.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={link('icons/cardrove-32.png')} />
    <link
      rel="apple-touch-icon"
      type="image/png"
      sizes="180x180"
      href={link('icons/cardrove-touch-v2.png')}
    />
    <meta name="apple-mobile-web-app-title" content={brand} />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('site-theme') || 'system';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={link()}>{brand}<span>.</span></a><nav aria-label="Main navigation">
        <a class:list={{ current: Astro.url.pathname.includes('/docs') }} href={link('docs/')}
          >Handbook</a
        >{repository && <a href={repository}>GitHub</a>}<button
          class="theme-toggle"
          aria-label="Switch color theme"
          ><svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="8"></circle><path
              d="M12 4a8 8 0 0 1 0 16Z"
              fill="currentColor"
              stroke="none"></path></svg
          ></button
        >
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <a class="wordmark" href={link()}>{brand}<span>.</span></a><p>A little, remembered.</p>
      </div><div>
        <a href={link('docs/self-host/')}>Host your own</a><a href={link('docs/compatibility/')}
          >Compatibility</a
        >{repository && <a href={repository}>Source code</a>}
      </div><p>Independent software.<br />No affiliation with Anki.</p>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const isDark = () =>
        document.documentElement.dataset.theme === 'dark' ||
        (document.documentElement.dataset.theme === 'system' &&
          matchMedia('(prefers-color-scheme: dark)').matches);
      const labelTheme = () =>
        button?.setAttribute(
          'aria-label',
          isDark() ? 'Switch to light theme' : 'Switch to dark theme',
        );
      labelTheme();
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', labelTheme);
      button?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        labelTheme();
        try {
          localStorage.setItem('site-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
